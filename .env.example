# Supabase (values printed by `npx supabase start` for local development)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers: a model is used only when its provider key is set
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
META_API_KEY=

# 1 = fake AI responses (development and E2E only, ignored in production)
AI_MOCK=0

# Google sign-in for local Supabase (also set enabled = true in supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
